OPENAI_API_KEY=
OPENAI_BASE_URL=https://token.sensenova.cn/v1
OPENAI_MODEL=sensenova-6.8-flash-lite
OPENAI_TIMEOUT=300
OPENAI_RETRIES=2
# Optional dedicated image-generation model setting. The API key and base URL
# fall back to OPENAI_API_KEY / OPENAI_BASE_URL above.
SENSENOVA_IMAGE_MODEL=sensenova-u1.5-lite
SENSENOVA_IMAGE_TIMEOUT=300
SENSENOVA_IMAGE_RETRIES=2
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# Zhipu CogView-3-Flash (--image-provider zhipu / auto failover).
# Key from https://open.bigmodel.cn; the free model needs no other settings.
ZHIPU_API_KEY=
ZHIPU_IMAGE_MODEL=cogview-3-flash
ZHIPU_IMAGE_TIMEOUT=180
ZHIPU_IMAGE_RETRIES=2
# Widest CogView resolution is 2:1, so output is centre-cropped to 16:9 by default.
ZHIPU_IMAGE_SIZE=1440x720
ZHIPU_IMAGE_CROP=1280x720
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Zhipu GLM story writing (--provider zhipu). Both models are free
# (input/output/cache) on the BigModel open platform.
ZHIPU_TEXT_MODEL=glm-4.7-flash
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_TIMEOUT=300
ZHIPU_RETRIES=2
# Default story provider for story_from_topic.py (mock | openai | gemini | zhipu).
STORY_PROVIDER=zhipu
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Audio8 TTS via local tts-hub. Defaults match the local service setup.
AUDIO8_SERVICE_URL=http://127.0.0.1:8024
TTS_HUB_URL=http://127.0.0.1:18084
AUDIO8_VOICE=default
# Optional overrides for automatic service startup:
# AUDIO8_START_SCRIPT=/home/hqb/ai-apps/audio8-tts-onnx-0.1b/serve_8024.sh
# TTS_HUB_START_SCRIPT=/home/hqb/ai-apps/tts-hub/run_server.sh

# Default scene-image provider: none / sensenova / zhipu / auto
IMAGE_PROVIDER=zhipu
